# Environment & Credentials (HASSAS BİLGİLER VE AYARLAR)
.env
*.env
*.pem
*.key

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments (Sanal Ortamlar)
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# IDE & Editor Settings (Editör Ayarları)
.vscode/
.idea/
*.swp
*.swo

# Logs & Temporary Files (Loglar ve Geçici Dosyalar)
*.log
tmp/
scratch/

# OS Generated Files (İşletim Sistemi Dosyaları)
.DS_Store
Thumbs.db

#
# Keep approved, secret-free migration tooling reviewable. Any other files in
# scripts/ remain ignored so credential delivery material cannot be tracked.
scripts/*
!scripts/generate_staff_pin_delivery.py
!scripts/migrate_staff_credentials.py
!scripts/staff_migration_db.py
!scripts/update_staff_credential.sql
*.txt
temp_*.py
check_git_leaks.py
move_tools.py
git_leak_report.txt

# Project memory under docs/ is intentionally tracked.  These files are the
# repository-wide source of truth for the security refactor and its progress.


